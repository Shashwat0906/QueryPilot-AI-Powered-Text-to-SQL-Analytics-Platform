# Frontend build-time settings. Copy to frontend/.env.local for local overrides.
# Values prefixed with VITE_ are embedded in the public JavaScript bundle,
# so never put secrets here.

# Base URL of the QueryPilot API. Leave empty in development (Vite proxies
# /api to localhost:8000). On Vercel set it to the Render service URL, e.g.
# VITE_API_BASE_URL=https://querypilot-api.onrender.com
VITE_API_BASE_URL=

# Development only: where the Vite dev server forwards /api requests.
# VITE_API_PROXY_TARGET=http://localhost:8000
