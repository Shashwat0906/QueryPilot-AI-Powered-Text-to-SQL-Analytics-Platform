# Copy to backend/.env and fill in what you need. Never commit backend/.env.
# Every value below is optional - the defaults run fully offline.

# --- LLM -------------------------------------------------------------------
# auto = use Anthropic if ANTHROPIC_API_KEY is set, else OpenAI if OPENAI_API_KEY
# is set, else the offline mock provider (example questions only).
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint
# llm = Claude writes the answer sentence from the real rows; template = no extra call
ANSWER_MODE=llm
# Override estimated prices (USD per million tokens) if they change:
# MODEL_PRICING_JSON={"claude-sonnet-5-5": {"input": 2.0, "output": 10.0}}

# --- Environment ---------------------------------------------------------------
# development | production (production adds HSTS)
ENVIRONMENT=development

# --- Databases ---------------------------------------------------------------
# DATABASE_URL=sqlite:///./data/business.db
# History/analytics. SQLite locally; PostgreSQL in production so it survives
# restarts (postgres:// and postgresql:// URLs are both accepted):
# METADATA_DATABASE_URL=postgresql://user:password@host:5432/querypilot
# APPROVED_TABLES=customers,products,orders,order_items

# --- Limits ------------------------------------------------------------------
MAX_RESULT_ROWS=500
QUERY_TIMEOUT_SECONDS=5
MAX_CORRECTION_ATTEMPTS=2
RATE_LIMIT_PER_MINUTE=30

# --- Public deployment ----------------------------------------------------------
# Browser origins allowed to call the API (comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex for extra origins such as Vercel preview URLs
# CORS_ORIGIN_REGEX=^https://querypilot-[a-z0-9-]+-yourname\.vercel\.app$
# Header holding the real client IP when behind a proxy that sets it (empty =
# connecting address). Only the last address in the header is used.
CLIENT_IP_HEADER=
# Daily caps for ALL visitors combined (0 = off). Protects your LLM budget.
DAILY_LLM_REQUEST_LIMIT=0
DAILY_COST_LIMIT_USD=0
# all = shared history; client = each browser sees only its own questions
HISTORY_SCOPE=all
ENABLE_API_DOCS=true

# --- Cache -------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=600
CACHE_MAX_ENTRIES=256
# CACHE_SENSITIVE_COLUMNS=email,phone,password,ssn
